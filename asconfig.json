{
  "targets": {
    "debug": {
      "outFile": "public/miniputt.wasm",
      "sourceMap": true,
      "debug": true
    },
    "release": {
      "outFile": "public/miniputt.wasm",
      "sourceMap": false,
      "optimizeLevel": 3,
      "shrinkLevel": 1,
      "converge": true,
      "noAssert": false
    }
  },
  "options": {
    "bindings": "raw",
    "runtime": "stub",
    "exportRuntime": false
  }
}
